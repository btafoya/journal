# Database
DATABASE_URL="postgresql://openjournal:openjournal_dev_password@localhost:5433/openjournal?schema=public"

# PostgreSQL
POSTGRES_USER=openjournal
POSTGRES_PASSWORD=openjournal_dev_password
POSTGRES_DB=openjournal
POSTGRES_PORT=5433

# Next.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-change-this-in-production

# Encryption (Generate with: openssl rand -base64 32)
ENCRYPTION_KEY=your-encryption-key-change-this-in-production
ENCRYPTION_SECRET=your-encryption-secret-change-this-in-production

# File Upload Settings
MAX_FILE_SIZE_MB=10  # Maximum file size in megabytes (default: 10MB)

# OAuth Providers (Add your credentials here)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Email Service (Postmark)
POSTMARK_API_KEY=your-postmark-api-key
POSTMARK_FROM_EMAIL=noreply@yourdomain.com
